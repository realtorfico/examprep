# Cloudflare Pages security headers. challenges.cloudflare.com = Turnstile on the
# redeem form (script-src + frame-src + connect-src, same as loantechies' contact form).
# Study-resource media (audio/video/pdf/image) is same-origin now -- served through
# /api/media/:file (signed, short-lived URLs via examprep-api's R2 binding) rather than
# a public R2 custom domain, so no external media host needs a CSP allowance.
# paypal.com/paypalobjects.com = PayPal's JS SDK + Smart Buttons on the /buy flow.
# Now fully on Live credentials — sandbox.paypal.com dropped from script-src/connect-src/frame-src.
# No other external origins needed — the API call is same-origin via worker.js's proxy.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com https://www.paypal.com https://www.paypalobjects.com; style-src 'self'; img-src 'self' data: https://www.paypalobjects.com; media-src 'self'; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com https://www.paypal.com; frame-src 'self' https://challenges.cloudflare.com https://www.paypal.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

/js/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=86400
/index.html
  Cache-Control: public, max-age=0, must-revalidate
